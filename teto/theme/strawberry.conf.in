background_image_keep_aspect_ratio=true
background_image_max_size=650
background_image_position=5
background_image_stretch=false
background_image_type=2
blur_radius=0
color-alternate-base=#E1E4E9
color-base=#f4f4f4
color-bright-text=#D5214B
color-button=#ffffff
color-button-text=#1D1D1D
color-placeholder-text=#818488
color-text=#1D1D1D
color-tooltip-base=#ffffff
color-tooltip-text=#1D1D1D
color-window=#D4D9DF
color-window-text=#1D1D1D
dark_mode=false
opacity_level=32
playlist_playing_song_color=#D5214B
style=Fusion
system_icons=true
tab_color=#D4D9DF
tab_gradient=false
tab_system_color=true
use-custom-color-set=true

[Behaviour]
doubleclick_addmode=1

[Collection]
monitor=true
startup_scan=true
